{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "*.md",
      "**/.*",
      "tests/**",
      "package.json",
      "package-lock.json",
      "node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/index.html",
        "destination": "/test.html",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/admin.html"
      }
    ]
  }
}
