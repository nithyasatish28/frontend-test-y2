rules_version = '2';

// Who can read and write what.
//   Instructors: anyone with a document in /admins (the first one is created by admin.html's setup).
//   Students:    anyone with a session's link. They type a name and get a nameless (anonymous) login,
//                which keeps each student to their own answers.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid));
    }
    // A session's link works while it's waiting or running, and for 6 hours after it ends, so
    // students can come back for their results once the instructor has marked them.
    function linkOpen(s) {
      return s.status == 'waiting'
        || (s.status == 'running' && request.time < s.startAt + duration.value(s.minutes + 10, 'm'))
        || (s.status == 'ended' && request.time < s.endAt + duration.value(6, 'h'));
    }
    // Students can save while the test is open, plus 3 minutes of grace.
    function canSave(s) {
      return s.status == 'waiting'
        || (s.status == 'running' && request.time < s.startAt + duration.value(s.minutes + 3, 'm'))
        || (s.status == 'ended' && request.time < s.endAt + duration.value(3, 'm'));
    }
    function goodName(d) { return d.name is string && d.name.size() > 0 && d.name.size() <= 60; }

    // Instructors must use a work email address, and must have clicked the link in the
    // verification email, so only someone who can read that mailbox can ever become one.
    // Change the domain here AND in js/config.js, then publish the rules again.
    function workEmail() {
      return request.auth.token.email is string
        && request.auth.token.email.lower().matches('^[^@]+@atriauniversity[.]edu[.]in$');
    }
    function verified() { return request.auth.token.email_verified == true; }

    // The super admin: the only person who can let a new instructor in, remove one, or hand the
    // role on. It is the first account set up (meta/owner), plus anyone it has marked
    // role: 'super'. The meta/owner half means an app set up before this rule existed still has
    // a super admin without anything being migrated.
    function isSuper() {
      return isAdmin() && (
           (exists(/databases/$(db)/documents/meta/owner)
             && get(/databases/$(db)/documents/meta/owner).data.uid == request.auth.uid)
        || get(/databases/$(db)/documents/admins/$(request.auth.uid)).data.get('role', '') == 'super');
    }
    // Who made a thing. Written when it is created and never changed afterwards. Documents from
    // before ownership existed have no field at all, which is why .get() with a default is used:
    // they belong to nobody until the super admin adopts them.
    function ownerOf(d) { return d.get('ownerUid', ''); }
    function mine(d) { return signedIn() && ownerOf(d) == request.auth.uid; }

    function goodRole(d) {
      return d.get('role', 'instructor') == 'super' || d.get('role', 'instructor') == 'instructor';
    }
    // The same domain, checked on a document being written rather than on the sign-in.
    function workEmailField(d) {
      return d.email is string && d.email.lower().matches('^[^@]+@atriauniversity[.]edu[.]in$');
    }

    // One-time setup: the first instructor account.
    match /meta/owner {
      allow get: if true;
      allow create: if signedIn() && workEmail() && verified()
        && request.resource.data.uid == request.auth.uid
        && existsAfter(/databases/$(db)/documents/admins/$(request.auth.uid));
      allow update, delete: if false;
    }

    match /admins/{uid} {
      // Your own row, so the app can tell what you are. The roster — who else is an instructor,
      // and their email addresses — is the super admin's business only.
      allow get: if (signedIn() && request.auth.uid == uid) || isSuper();
      allow list: if isSuper();
      // Either an instructor approving someone, or the very first account setting itself up.
      // Both ways the address has to be a work address.
      allow create: if workEmailField(request.resource.data) && goodRole(request.resource.data) && (
           isSuper()
        || (signedIn() && uid == request.auth.uid && workEmail() && verified()
            && !exists(/databases/$(db)/documents/meta/owner)
            && getAfter(/databases/$(db)/documents/meta/owner).data.uid == request.auth.uid));
      // Changing a role, or removing an instructor: the super admin, and never on themselves,
      // so the last super admin can't lock everybody out by accident.
      allow update: if isSuper() && uid != request.auth.uid
        && workEmailField(request.resource.data) && goodRole(request.resource.data);
      allow delete: if isSuper() && uid != request.auth.uid;
    }

    // Someone with a verified work email asking to be made an instructor. They can write their
    // own request and take it back; only an instructor can read the list or act on it.
    match /pendingAdmins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isSuper());
      allow list: if isSuper();
      allow create: if signedIn() && request.auth.uid == uid
        && workEmail() && verified()
        && request.resource.data.email == request.auth.token.email
        && goodName(request.resource.data);
      allow update: if false;
      allow delete: if isSuper() || (signedIn() && request.auth.uid == uid);
    }

    // Which session the Live tab shows.
    match /settings/app {
      allow read, write: if isAdmin();
    }

    // Question sets hold the answers, so only instructors can read them — and only the
    // instructor who wrote a set, or the super admin.
    match /questionSets/{id} {
      allow get: if isSuper() || (isAdmin() && mine(resource.data));
      // A plain instructor's query must say where ownerUid == their own uid; the super admin's
      // need not, because isSuper() holds whatever the document is.
      allow list: if isSuper() || (isAdmin() && mine(resource.data));
      allow create: if isAdmin() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if (isSuper() || (isAdmin() && mine(resource.data)))
        && request.resource.data.ownerUid == resource.data.get('ownerUid', request.auth.uid);
      allow delete: if isSuper() || (isAdmin() && mine(resource.data));
    }

    // Which session each instructor has open in their Live tab. One per instructor: a single
    // shared value would have two people teaching at once fighting over it.
    match /instructorSettings/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // A session holds a copy of the questions with the answers hashed.
    match /sessions/{sid} {
      // Students still open any session whose link is live — that is what the link is for.
      allow get: if isSuper() || (isAdmin() && mine(resource.data)) || (signedIn() && linkOpen(resource.data));
      allow list: if isSuper() || (isAdmin() && mine(resource.data));
      allow create: if isAdmin() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if (isSuper() || (isAdmin() && mine(resource.data)))
        && request.resource.data.ownerUid == resource.data.get('ownerUid', request.auth.uid);
      allow delete: if isSuper() || (isAdmin() && mine(resource.data));

      function session() { return get(/databases/$(db)/documents/sessions/$(sid)).data; }
      // An instructor reads the answers to their own sessions. Costs one extra document read.
      function runsThis() { return isAdmin() && (isSuper() || ownerOf(session()) == request.auth.uid); }

      // The answers held back from an exam. Nobody but the instructor running it.
      match /secret/{doc} {
        allow read, write: if runsThis();
      }

      match /attempts/{uid} {
        allow read: if runsThis() || (signedIn() && request.auth.uid == uid);
        allow create: if runsThis()
          || (signedIn() && request.auth.uid == uid
              && request.resource.data.uid == uid && goodName(request.resource.data)
              && canSave(session()));
        allow update: if runsThis()
          || (signedIn() && request.auth.uid == uid
              && request.resource.data.uid == uid && goodName(request.resource.data)
              && resource.data.get('status', '') != 'submitted'
              && canSave(session()));
        // A student can take back their own entry before the test starts ("Not you?").
        allow delete: if runsThis()
          || (signedIn() && request.auth.uid == uid && resource.data.get('status', '') == 'waiting');
      }
    }
  }
}
