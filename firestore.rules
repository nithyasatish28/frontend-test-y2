rules_version = '2';

// Who can read and write what.
//   Instructors: anyone with a document in /admins (the first one is created by admin.html's setup).
//   Students:    anyone with a document in /users that isn't disabled.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid));
    }
    function signupOpen() {
      let s = /databases/$(db)/documents/settings/app;
      return exists(s) && get(s).data.get('signupOpen', false) == true;
    }
    function activeStudent() {
      let u = /databases/$(db)/documents/users/$(request.auth.uid);
      return signedIn() && exists(u) && get(u).data.get('disabled', false) != true;
    }

    // One-time setup: the first instructor account.
    match /meta/owner {
      allow get: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && existsAfter(/databases/$(db)/documents/admins/$(request.auth.uid));
      allow update, delete: if false;
    }

    match /admins/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin()
        || (signedIn() && uid == request.auth.uid
            && !exists(/databases/$(db)/documents/meta/owner)
            && getAfter(/databases/$(db)/documents/meta/owner).data.uid == request.auth.uid);
      allow update, delete: if isAdmin() && uid != request.auth.uid;
    }

    // Sign-ups open/closed, and which session the plain student link opens.
    match /settings/app {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    // name → login email, so students can sign in with their name.
    match /usernames/{key} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if signedIn() && signupOpen()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name']);
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid && signupOpen()
        && request.resource.data.disabled == false
        && getAfter(/databases/$(db)/documents/usernames/$(request.resource.data.nameKey)).data.uid == uid;
      allow update, delete: if isAdmin();
    }

    // Question sets hold the answers, so only instructors can read them.
    match /questionSets/{id} {
      allow read, write: if isAdmin();
    }

    // A session holds a copy of the questions with the answers hashed.
    match /sessions/{sid} {
      allow get: if signedIn();
      allow list, write: if isAdmin();

      // Students can save while the test is open, plus 3 minutes of grace.
      function canSave() {
        let s = get(/databases/$(db)/documents/sessions/$(sid)).data;
        return s.status == 'waiting'
          || (s.status == 'running' && request.time < s.startAt + duration.value(s.minutes + 3, 'm'))
          || (s.status == 'ended' && request.time < s.endAt + duration.value(3, 'm'));
      }

      match /attempts/{uid} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow create: if isAdmin()
          || (activeStudent() && request.auth.uid == uid
              && request.resource.data.uid == uid && canSave());
        allow update: if isAdmin()
          || (activeStudent() && request.auth.uid == uid
              && request.resource.data.uid == uid
              && resource.data.get('status', '') != 'submitted'
              && canSave());
        allow delete: if isAdmin();
      }
    }
  }
}
