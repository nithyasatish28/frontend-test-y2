rules_version = '2';

// Who can read and write what.
//   Instructors: anyone with a document in /admins (the first one is created by admin.html's setup).
//   Students:    anyone with a session's link. They type a name and get a nameless (anonymous) login,
//                which keeps each student to their own answers.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid));
    }
    // A session's link works while it's waiting or running, and for 10 minutes after it ends
    // (so students can see their score). After that it's closed.
    function linkOpen(s) {
      return s.status == 'waiting'
        || (s.status == 'running' && request.time < s.startAt + duration.value(s.minutes + 10, 'm'))
        || (s.status == 'ended' && request.time < s.endAt + duration.value(10, 'm'));
    }
    // Students can save while the test is open, plus 3 minutes of grace.
    function canSave(s) {
      return s.status == 'waiting'
        || (s.status == 'running' && request.time < s.startAt + duration.value(s.minutes + 3, 'm'))
        || (s.status == 'ended' && request.time < s.endAt + duration.value(3, 'm'));
    }
    function goodName(d) { return d.name is string && d.name.size() > 0 && d.name.size() <= 60; }

    // One-time setup: the first instructor account.
    match /meta/owner {
      allow get: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && existsAfter(/databases/$(db)/documents/admins/$(request.auth.uid));
      allow update, delete: if false;
    }

    match /admins/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin()
        || (signedIn() && uid == request.auth.uid
            && !exists(/databases/$(db)/documents/meta/owner)
            && getAfter(/databases/$(db)/documents/meta/owner).data.uid == request.auth.uid);
      allow update, delete: if isAdmin() && uid != request.auth.uid;
    }

    // Which session the Live tab shows.
    match /settings/app {
      allow read, write: if isAdmin();
    }

    // Question sets hold the answers, so only instructors can read them.
    match /questionSets/{id} {
      allow read, write: if isAdmin();
    }

    // A session holds a copy of the questions with the answers hashed.
    match /sessions/{sid} {
      allow get: if isAdmin() || (signedIn() && linkOpen(resource.data));
      allow list, write: if isAdmin();

      function session() { return get(/databases/$(db)/documents/sessions/$(sid)).data; }

      match /attempts/{uid} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow create: if isAdmin()
          || (signedIn() && request.auth.uid == uid
              && request.resource.data.uid == uid && goodName(request.resource.data)
              && canSave(session()));
        allow update: if isAdmin()
          || (signedIn() && request.auth.uid == uid
              && request.resource.data.uid == uid && goodName(request.resource.data)
              && resource.data.get('status', '') != 'submitted'
              && canSave(session()));
        // A student can take back their own entry before the test starts ("Not you?").
        allow delete: if isAdmin()
          || (signedIn() && request.auth.uid == uid && resource.data.get('status', '') == 'waiting');
      }
    }
  }
}
